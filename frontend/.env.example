# Copy to .env.local for local development. The browser calls the API directly
# (ADR-023), so this URL must be in the backend's CORS allowlist
# (SERFIRA_SECURITY_CORS_ALLOWED_ORIGINS, e.g. http://localhost:3000).
#
# Next.js inlines NEXT_PUBLIC_* at BUILD time. Development may omit this variable
# (falls back to http://localhost:8080); a production `next build` fails without it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
